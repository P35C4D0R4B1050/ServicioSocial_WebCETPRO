# =====================================================================
# Sistema de Matrícula del CETPRO "Joaquín López Antay"
# Qué NO entra al repositorio (ver docs/07-proceso-de-desarrollo/02-convenciones-tecnicas.md, sección 1).
# Regla de oro: ningún dato personal real ni secreto llega al repositorio (AD-36, RNF-18).
# =====================================================================

# ---------------------------------------------------------------------
# 1. Secretos y configuración local
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
!*.env.example
secrets/
*.secrets.json
*.secret
appsettings.*.local.json
appsettings.Local.json
secrets.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.kdbx
id_rsa*
id_ed25519*
*.ppk
*.age
.sops/
credenciales*
tokens*.txt

# ---------------------------------------------------------------------
# 2. Datos reales, respaldos y salidas operativas (nunca versionar)
# ---------------------------------------------------------------------
datos-reales/
datos_reales/
backups/
respaldos/
exportaciones/
salidas/
*.dump
*.backup
*.bak
*.sql.gz
*.sql.zst
*.sqlite
*.sqlite3
*.db
*.mdf
*.ldf
pgdata/
postgres-data/
# Archivos generados para AVANZA a partir de datos reales
avanza-export*/
*-export-real*

# ---------------------------------------------------------------------
# 3. Material de terceros o ajeno al proyecto (no se publica)
# ---------------------------------------------------------------------
# Norma ISO/IEC 27002:2022 en español: documento con derechos de autor (de pago).
# Se conserva solo en el equipo; los documentos la citan por su número de control.
Contexto/Normativa/ISO*.pdf
# Informe 004: lista nombres de integrantes, tutora y Directora, y la dirección del CETPRO.
Contexto/Antecedentes/Informe_004*
# Documentación completa de otro proyecto del equipo (solo referencia local).
Contexto/DocumentacionEjemplo/
# Propuesta de otro proyecto (contiene nombres de docente y estudiantes).
Contexto/Referencia-de-formato/

# ---------------------------------------------------------------------
# 4. Compilación, dependencias y pruebas
# ---------------------------------------------------------------------
bin/
obj/
publish/
out/
dist/
build/
node_modules/
.pnpm-store/
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
