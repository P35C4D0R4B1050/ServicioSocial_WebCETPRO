# /etc/keepalive.env  (copiar desde keepalive.env.example y ajustar)

# Ráfaga de CPU cada hora
BURST_MINUTES=7
BURST_CPU_LOAD=40

# Solo VM Ampere A1: retener memoria durante la ráfaga (MB). Dejar en 0 en la VM-DB si
# PostgreSQL ya usa más del 20 % de la RAM; subir en VM-APP si queda por debajo.
HOLD_MEM_MB=0

# No agregar carga si la VM ya está ocupada
SKIP_IF_BUSY_PCT=50

# Alerta local: el percentil 95 de CPU de los últimos 7 días debe superar este valor.
# Oracle usa 20; se deja margen.
TARGET_P95=30

# Aviso externo (Healthchecks.io, plan gratuito): crear un check con periodo de 1 día
# y gracia de 12 h, y pegar aquí su URL de ping.
HC_URL=
